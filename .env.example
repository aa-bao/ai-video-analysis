# P2 · AI 视频解析 Agent —— 部署环境变量模板（复制为 .env 后填写；不得提交 .env）
#
# 与 P1 共用同一个 PG 容器（方案 §7.1：1 容器 2 库）。以下 POSTGRES_* 必须与
# P1 的 .env 中 PG 凭据保持一致（P2 连的是同一个 PG 实例里的 `video` 库）。

# ── PostgreSQL（P1 起的那个 PG 容器；P2 连其中的 video 库）──
# compose 变量替换用：DATABASE_URL / db-migrate 的 PGUSER/PGPASSWORD 都从这里取。
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
# 本地直跑（非 compose）时用；compose 内 video 服务会自行改写为 postgres:5432/video。
DATABASE_URL=postgresql+asyncpg://rag:rag@127.0.0.1:5432/video

# ── 应用基础 ──
# production / development；生产 fail-closed（见下方 DEV_AUTH_BYPASS / VIDEO_MEDIA_EGRESS_PROXY）
APP_ENV=production
APP_DATA_ROOT=/app/data
APP_SECRET_ROOT=/run/secrets
# 生产化密钥目录（宿主机侧 bind mount 源；见 docker-compose.yml 的 video 服务）：
# test / production 下容器把该目录挂到 /run/secrets，密钥文件按"环境变量名"命名。
# development 不读取此目录，无副作用。默认 ./secrets。
APP_SECRET_DIR=./secrets

# ── 系统模型中转（VideoAgentSettings 未配 Chat 时的回退通道）──
MODEL_RELAY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_RELAY_API_KEY=
CHAT_MODEL=doubao-seed-2-1-pro-260628

# ── 视频 agent：ASR（火山引擎录音文件极速识别）──
VOLC_ASR_API_KEY=
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# ── 视频 agent：Chat（豆包方舟，OpenAI 兼容；留空回退系统中转）──
VOLC_CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_CHAT_MODEL=doubao-seed-2-1-pro-260628
VOLC_CHAT_QA_MODEL=doubao-seed-2-1-turbo-260628
VOLC_CHAT_API_KEY=
VOLC_CHAT_QA_BASE_URL=
VOLC_CHAT_QA_API_KEY=

# ── 微信视频号下载服务（wx-channels，仅 P2 使用；compose 内服务名 wx-channels）──
# 宿主侧访问填 http://127.0.0.1:2022；compose 内 video 服务默认走 http://wx-channels:2022
WX_CHANNELS_API_BASE_URL=http://127.0.0.1:2022

# ── 磁盘配额与阈值（应用层实现；变量名不可改）──
# 视频产物硬配额 35 GiB（= 37580963840 字节），由另一 agent 在应用层强制。
VIDEO_ARTIFACT_QUOTA_BYTES=37580963840
# 磁盘用量告警 / 严重阈值（百分比）。
VIDEO_DISK_WARN_PERCENT=80
VIDEO_DISK_CRITICAL_PERCENT=90

# ── 远端媒体出口代理（重要语义，请勿"修复"）──
# 生产类环境（APP_ENV ∈ production/prod…）下，若未配置 VIDEO_MEDIA_EGRESS_PROXY，
# src/video/acquire.py 的 _configured_media_egress_proxy() 会 fail-closed：远端媒体获取被
# 禁用，用户需改用本地文件上传。这是既有设计（非 bug），目的是在无内网隔离代理时
# 避免直连公网远端媒体。配置为"阻断公网、仅放行内网"的私有 HTTP(S) 代理 URL 即可放行。
# 取值优先级：先读 $APP_SECRET_ROOT/VIDEO_MEDIA_EGRESS_PROXY 文件，再回退本环境变量。
VIDEO_MEDIA_EGRESS_PROXY=

# ── 本地开发跳过登录（仅 APP_ENV=development 且置 1 时生效，生产 fail-closed）──
DEV_AUTH_BYPASS=
DEV_AUTH_BYPASS_USER_ID=1

# ── 生产化密钥清单（仅 test / production；development 忽略）──
# 把密钥写入 ./secrets/<文件名>（内容即密钥值，不要引号/换行，建议 chmod 600）：
#   config.yaml 占位符对应的密钥文件（P2 这 3 个均在 _OPTIONAL_SECRET_FILES，缺失不报错、回退空）：
#     ./secrets/MODEL_RELAY_BASE_URL   系统中转 Base URL
#     ./secrets/MODEL_RELAY_API_KEY    系统中转 API Key
#     ./secrets/CHAT_MODEL             对话模型名
# 注：DATABASE_URL 由 compose 直接注入（覆盖），不走密钥文件。
# 注：VOLC_ASR_* / VOLC_CHAT_* / WX_CHANNELS_API_BASE_URL / DEV_AUTH_BYPASS 等由 compose 以
#     环境变量直接注入（源码 src/video/settings.py、security.py、acquire.py 直读 os.environ），
#     不需放进 ./secrets/ 密钥文件；VIDEO_MEDIA_EGRESS_PROXY 既可走环境变量也可走
#     ./secrets/VIDEO_MEDIA_EGRESS_PROXY 文件（缺失则 fail-closed 禁用远端媒体，非启动失败）。
